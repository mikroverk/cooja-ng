# CC2650 SmartRF06 buttons through the GPIO input model: the board's five
# buttons (Key Left/Right/Up/Down/Select) are active-low with the IOC
# pull-up, so a released button reads 1 on DIN, and a press is a falling
# edge that sets GPIO EVFLAGS and raises the AON GPIO edge interrupt
# (IOCFG EDGE_DET / EDGE_IRQ_EN, as TI's PIN driver configures them for
# button-hal). The platform button is Key Select (DIO11).
#   ./build/test_runner test configs/test-button-cc2650-srf06.yaml --script test/scripts/button-cc2650-srf06.cnsh
expect 1 "Device button count: 5" 1s
wait-until 1s

# Key Select, the board's select button: press, hold past one periodic event, release.
button 1 press
expect 1 "Press event (Key Select)" 50ms
expect 1 "Periodic event, 1 seconds (Key Select)" 1100ms
button 1 release
expect 1 "Release event (Key Select)" 50ms

# Key Left (DIO15) through the pin itself.
wait-until 3s
gpio 1 P0.15 low
expect 1 "Press event (Key Left)" 50ms
gpio 1 P0.15 release
expect 1 "Release event (Key Left)" 50ms

# Key Right (DIO18).
wait-until 3s
gpio 1 P0.18 low
expect 1 "Press event (Key Right)" 50ms
gpio 1 P0.18 release
expect 1 "Release event (Key Right)" 50ms

# Key Up (DIO19).
wait-until 3s
gpio 1 P0.19 low
expect 1 "Press event (Key Up)" 50ms
gpio 1 P0.19 release
expect 1 "Release event (Key Up)" 50ms

# Key Down (DIO12).
wait-until 3s
gpio 1 P0.12 low
expect 1 "Press event (Key Down)" 50ms
gpio 1 P0.12 release
expect 1 "Release event (Key Down)" 50ms
